# Copy to .env (and `source .env`) or set these as GitHub Actions secrets.

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Chat id to deliver the daily report to (your user id, group, or channel).
# Get it from @userinfobot, or from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional: path to a non-default config file
# TRUMPSCRAPER_CONFIG=config.yaml
